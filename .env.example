# General
NODE_ENV=development
DEBUG=true

# Services
DESIGN_SERVICE_URL=http://localhost:8000
USER_SERVICE_URL=http://localhost:8001
FRONTEND_URL=http://localhost:3000

# Database Configuration
# Database type: postgresql, mysql, or tidb
DB_DATABASE_TYPE=tidb

# TiDB Serverless Connection (default)
DB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USERNAME=kbFV66oHabEtRud.root
DB_PASSWORD=aPdG5f34Qjzs0gBM
DB_DATABASE=test

# SSL/TLS Configuration (required for TiDB Serverless)
# The CA certificate file should be in the project root
DB_SSL_CA=./ca.pem
DB_SSL_VERIFY_CERT=true
DB_SSL_VERIFY_IDENTITY=true

# Connection Pool Settings (optimized for TiDB)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true

# Connection Timeout Settings
DB_CONNECT_TIMEOUT=10
DB_READ_TIMEOUT=30
DB_WRITE_TIMEOUT=30

# MySQL/TiDB Specific
DB_CHARSET=utf8mb4

# Query Settings
DB_ECHO=false
DB_ECHO_POOL=false

# Legacy PostgreSQL Configuration (for reference/fallback)
# DB_DATABASE_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=change-in-production
# DB_DATABASE=designsynapse
# DB_SSL_MODE=prefer

# Redis (for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-in-production
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-in-production
JWT_EXPIRATION=24h

# AWS
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=change-in-production
AWS_SECRET_ACCESS_KEY=change-in-production

# Vector Search Configuration
VECTOR_PROVIDER=pinecone
PINECONE_API_KEY=change-in-production
PINECONE_ENVIRONMENT=us-west1-gcp-free
PINECONE_INDEX_NAME=knowledge-resources

# Alternative: Qdrant (for local development)
# VECTOR_PROVIDER=qdrant
# QDRANT_URL=http://localhost:6333

# LLM Configuration
LLM_PRIMARY_PROVIDER=openai
OPENAI_API_KEY=change-in-production
OPENAI_MODEL=gpt-3.5-turbo

# Content Analysis Settings
ENABLE_AUTO_TAGGING=true
ENABLE_SUMMARY_GENERATION=true
ENABLE_KEY_TAKEAWAYS=true
MIN_CONTENT_LENGTH=100
MAX_CONTENT_LENGTH=1000000

# Search and Caching Configuration
SEARCH_ENABLE_SEARCH_CACHE=true
SEARCH_CACHE_TTL_MINUTES=60
SEARCH_SEARCH_CACHE_MAX_SIZE=1000
SEARCH_EMBEDDING_CACHE_MAX_SIZE=500
SEARCH_ENABLE_CACHE_COMPRESSION=true
SEARCH_REDIS_URL=redis://localhost:6379

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20

# File Processing
FILE_MAX_FILE_SIZE_MB=50
FILE_MAX_BATCH_SIZE=10
FILE_SUPPORTED_TYPES=pdf,docx,txt,md,html
FILE_CHUNK_SIZE=1000
FILE_CHUNK_OVERLAP=200

# Authentication
JWT_SECRET_KEY=change-in-production
SERVICE_SECRET_KEY=change-in-production
