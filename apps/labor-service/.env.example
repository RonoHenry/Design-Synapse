# Labor Services Marketplace Environment Configuration

# Application settings
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8006

# Database configuration (TiDB Serverless)
DATABASE_URL=mysql+pymysql://username:password@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/labor_service?ssl_ca=/etc/ssl/cert.pem&ssl_verify_cert=true&ssl_verify_identity=true
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis configuration
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# External service URLs
USER_SERVICE_URL=http://localhost:8001
PROJECT_SERVICE_URL=http://localhost:8002
VENDOR_SERVICE_URL=http://localhost:8005

# Payment gateway (Stripe)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Geolocation services
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token

# Notification services
SENDGRID_API_KEY=your_sendgrid_api_key
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# File storage (AWS S3)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=labor-service-files

# Search (Elasticsearch)
ELASTICSEARCH_URL=http://localhost:9200

# Background checks
CHECKR_API_KEY=your_checkr_api_key

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Matching algorithm settings
MATCHING_RADIUS_MILES=50
MAX_PROVIDERS_PER_MATCH=20

# Business settings
PLATFORM_FEE_PERCENTAGE=5.0
ESCROW_HOLD_DAYS=7