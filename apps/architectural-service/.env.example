# Architectural Service Environment Configuration

# ============================================================================
# Database Configuration
# ============================================================================

# Database connection URL
# Format: mysql+aiomysql://user:password@host:port/database
DATABASE_URL=mysql+aiomysql://root:password@localhost:4000/architectural_service

# Connection pool settings
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# ============================================================================
# External Service URLs
# ============================================================================

# Design Service - Visual rendering and generation
DESIGN_SERVICE_URL=http://design-service:8000

# Knowledge Service - Building codes and standards
KNOWLEDGE_SERVICE_URL=http://knowledge-service:8000

# Project Service - Project management and lifecycle
PROJECT_SERVICE_URL=http://project-service:8000

# Vendor Service - Material specifications and suppliers
VENDOR_SERVICE_URL=http://vendor-service:8000

# ============================================================================
# Redis Cache Configuration
# ============================================================================

# Redis connection URL
REDIS_URL=redis://localhost:6379/0

# Cache settings
CACHE_TTL=3600
CACHE_ENABLED=true

# ============================================================================
# Authentication Configuration
# ============================================================================

# JWT settings
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================================
# Service Configuration
# ============================================================================

# Service identification
SERVICE_NAME=architectural-service
APP_VERSION=1.0.0

# Environment
DEBUG=false
LOG_LEVEL=INFO

# API configuration
API_V1_PREFIX=/api/v1

# ============================================================================
# CORS Configuration
# ============================================================================

ENABLE_CORS=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# ============================================================================
# Circuit Breaker Configuration
# ============================================================================

# Number of failures before circuit opens
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

# Seconds to wait before attempting recovery
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60

# Expected exception type for circuit breaker
CIRCUIT_BREAKER_EXPECTED_EXCEPTION=httpx.HTTPError

# ============================================================================
# Retry Configuration
# ============================================================================

# Maximum number of retry attempts
RETRY_MAX_ATTEMPTS=5

# Initial delay in seconds
RETRY_INITIAL_DELAY=1.0

# Maximum delay in seconds
RETRY_MAX_DELAY=16.0

# Exponential backoff base
RETRY_EXPONENTIAL_BASE=2.0

# ============================================================================
# Rate Limiting Configuration
# ============================================================================

# Requests per minute per user
RATE_LIMIT_PER_MINUTE=100

# Burst allowance
RATE_LIMIT_BURST=20

# ============================================================================
# Monitoring and Observability
# ============================================================================

# Enable metrics collection
ENABLE_METRICS=true

# Metrics export endpoint
METRICS_ENDPOINT=/metrics

# Enable request tracing
ENABLE_TRACING=false

# Tracing service endpoint (e.g., Jaeger)
TRACING_ENDPOINT=http://jaeger:14268/api/traces

# ============================================================================
# WebSocket Configuration
# ============================================================================

# WebSocket heartbeat interval (seconds)
WEBSOCKET_HEARTBEAT_INTERVAL=30

# WebSocket connection timeout (seconds)
WEBSOCKET_TIMEOUT=300

# ============================================================================
# File Upload Configuration
# ============================================================================

# Maximum file size for drawings (bytes)
MAX_DRAWING_FILE_SIZE=52428800  # 50MB

# Allowed drawing file types
ALLOWED_DRAWING_TYPES=["application/pdf","image/png","image/jpeg","application/dwg"]

# Storage backend (local, s3, azure)
STORAGE_BACKEND=local

# Local storage path
LOCAL_STORAGE_PATH=/var/lib/architectural-service/uploads

# S3 configuration (if using S3)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=architectural-service-uploads
# AWS_REGION=us-west-2

# ============================================================================
# Background Job Configuration
# ============================================================================

# Celery broker URL (for async tasks)
CELERY_BROKER_URL=redis://localhost:6379/1

# Celery result backend
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ============================================================================
# Development Settings
# ============================================================================

# Enable SQL query logging
SQL_ECHO=false

# Enable auto-reload on code changes
AUTO_RELOAD=false

# Enable API documentation endpoints
ENABLE_DOCS=true

# ============================================================================
# Production Settings
# ============================================================================

# Security headers
ENABLE_SECURITY_HEADERS=true

# HTTPS redirect
FORCE_HTTPS=false

# Trusted proxy headers
TRUST_PROXY_HEADERS=false

# ============================================================================
# Testing Configuration
# ============================================================================

# Test database URL (used in tests)
TEST_DATABASE_URL=mysql+aiomysql://root:password@localhost:4000/architectural_service_test

# Test Redis URL
TEST_REDIS_URL=redis://localhost:6379/15

# Hypothesis profile (default, ci, dev)
HYPOTHESIS_PROFILE=default
