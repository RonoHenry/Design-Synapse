# Git
.git
.gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.env
.venv*
env/
venv/
ENV/
env.bak/
venv.bak/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
logs/

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
.coverage
.coverage.*
.cache
.pytest_cache/

# Node.js (for frontend)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database files
*.db
*.sqlite
*.sqlite3

# Temporary files
tmp/
temp/
.tmp/
.temp/

# Documentation
docs/
*.md
README*

# Test files and directories - EXCLUDE ALL
tests/
**/tests/
test_*.py
*_test.py
**/test_*
**/*_test*
**/*test*

# Migration files (keep only the ones needed)
migrations/versions/
!migrations/versions/*_initial_*.py

# Storage directories
storage/
.storage/

# Backup files
*.bak
*.backup

# Environment files (keep only .env.example)
.env.*
!.env.example

# Certificates (except ca.pem which is needed)
*.pem
*.crt
*.key
!ca.pem

# Build artifacts
*.tar.gz
*.zip

# Jupyter notebooks
.ipynb_checkpoints/

# PyCharm
.idea/

# Alembic
alembic.ini

# Scripts (development only) - EXCLUDE ALL
scripts/
apply_*.py
verify_*.py
debug_*.py
test_*.py
check_*.py
cleanup_*.py
reset_*.py
restore_*.py

# Summary files - EXCLUDE ALL
*_SUMMARY.md
*_PROGRESS.md
*_REPORT.md
*_NOTES.md
*SUMMARY*
*PROGRESS*
*REPORT*
*NOTES*

# Spec files (development only) - EXCLUDE ALL
.kiro/

# Docker
Dockerfile*
docker-compose*.yml

# Requirements files (except the ones we need)
requirements-dev*.txt

# Exclude other service directories when building specific service
# This will be overridden by specific build contexts
apps/analytics-service/
apps/frontend/
apps/marketplace-service/
apps/vendor-service/

# Exclude infra and workflows
infra/
workflows/

# Exclude examples
examples/
**/examples/
